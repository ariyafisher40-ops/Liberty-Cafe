# Liberty Cafe — Environment Variables
# Copy to .env.local for local development and set in Cloudflare Pages/Workers for deployment.
# NEVER add Supabase service-role keys or private payment secrets to any VITE_ variable.

# Required after Supabase setup:
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
# Alternative public key name supported by newer Supabase projects:
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Recommended canonical public site URL (used for Auth redirect URLs):
VITE_SITE_URL="http://localhost:3000"

# Optional storefront preview label toggle for demo catalogue items (true/false):
VITE_ENABLE_DEMO_MENU_BADGE="false"
